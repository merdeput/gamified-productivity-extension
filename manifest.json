{
  "manifest_version": 3,
  "name": "Fokus",
  "version": "0.5.2",
  "description": "Create focus tasks, run timed missions, earn seeds, and view garden progress placeholders.",
  "permissions": ["storage", "alarms", "sidePanel", "webNavigation", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Fokus"
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["logic/blocking/blockedSitePage.html", "logic/blocking/blockedSitePage.css", "logic/blocking/blockedSitePage.js", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
