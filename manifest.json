{
  "manifest_version": 3,
  "name": "Fokus",
  "version": "0.4.2",
  "description": "Create focus tasks, run timed missions, earn seeds, and view garden progress placeholders.",
  "permissions": ["storage", "alarms", "sidePanel"],
  "action": {
    "default_title": "Fokus"
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
